{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Formulare",
  "version": "0.1.0",
  "identifier": "de.pendzialek.formulare",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1470",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Formulare",
        "width": 1400,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 640,
        "decorations": false,
        "shadow": true,
        "label": "main"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self' blob:; connect-src 'self' data: blob:"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "category": "Productivity",
    "shortDescription": "Bauantragsformulare aus SJ FORMA bequem ausfüllen",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": [
          "German"
        ]
      },
      "wix": {
        "language": "de-DE"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQxRjZBRkRGNjZBMDUzNDcKUldSSFU2Qm0zNi8yUVhCNkM5YVFITG56a2xYMDNwdjFzOC9IVnRLWGtEZ0l3TURPS0JPaXMrenUK",
      "endpoints": [
        "https://github.com/axelcypher/arch-tools/releases/download/updater/formulare.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}

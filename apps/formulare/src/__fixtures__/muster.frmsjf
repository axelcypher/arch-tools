        object Label86: TLabel
          Left = 5
          Top = 28
          Width = 655
          Height = 80
          AutoSize = False
          Caption = 
            'Nach '#167' 63 Absatz 3 Satz 4 BauO NRW 2018 darf einen Monat nach Ei' +
            'ngang der erforderlichen'#13#10'Unterlagen bei der Bauaufsichtsbeh'#246'rde' +
            ' mit dem Vorhaben begonnen werden. Mit dem Vorhaben'#13#10'kann unverz' +
            #252'glich begonnen werden, wenn die Gemeinde der Bauherrschaft vor ' +
            'Ablauf dieser Frist'#13#10'mitteilt, dass kein Genehmigungsverfahren d' +
            'urchgef'#252'hrt werden soll und sie eine Untersagung'#13#10'nach '#167' 15 Absa' +
            'tz 1 Satz 2 BauGB nicht beantragen wird. '
          Font.Charset = ANSI_CHARSET
          Font.Color = clWindowText
          Font.Height = -13
          Font.Name = 'Arial'
          Font.Style = []
          ParentFont = False
          Transparent = True
        end

{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FABRIO",
  "version": "0.6.1",
  "identifier": "de.pendzialek.ava",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1490",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "FABRIO",
        "width": 1500,
        "height": 950,
        "minWidth": 1000,
        "minHeight": 640,
        "decorations": false,
        "shadow": true,
        "label": "main"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self' blob:; connect-src 'self' data: blob: https://nominatim.openstreetmap.org https://api.open-meteo.com https://archive-api.open-meteo.com"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "category": "Productivity",
    "shortDescription": "Ausschreibung, Vergabe, Abrechnung und Bauleitung",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": [
          "German"
        ],
        "installerHooks": "windows/umbenennung.nsh"
      },
      "wix": {
        "language": "de-DE",
        "upgradeCode": "5e086816-30f8-5e95-add0-69fcb29b91c1"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQxRjZBRkRGNjZBMDUzNDcKUldSSFU2Qm0zNi8yUVhCNkM5YVFITG56a2xYMDNwdjFzOC9IVnRLWGtEZ0l3TURPS0JPaXMrenUK",
      "endpoints": [
        "https://github.com/axelcypher/arch-tools/releases/download/updater/ava.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}

{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ATLAS",
  "version": "0.28.0",
  "identifier": "de.pendzialek.projektordner",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1450",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ATLAS",
        "width": 1280,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 640,
        "decorations": false,
        "shadow": true,
        "label": "main",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self' blob:; connect-src 'self' data: blob: https://nominatim.openstreetmap.org"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "category": "Productivity",
    "shortDescription": "Projekte anlegen und fortschreiben: Assistent, Projektordner nach Schema, Vorlagen, Prüfung, Katasterpläne",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": [
          "German"
        ],
        "installerHooks": "windows/umbenennung.nsh"
      },
      "wix": {
        "language": "de-DE",
        "upgradeCode": "45ef07ae-77b5-56e1-ab4f-e3feed79a2fa"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQxRjZBRkRGNjZBMDUzNDcKUldSSFU2Qm0zNi8yUVhCNkM5YVFITG56a2xYMDNwdjFzOC9IVnRLWGtEZ0l3TURPS0JPaXMrenUK",
      "endpoints": [
        "https://github.com/axelcypher/arch-tools/releases/download/updater/ordner.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}

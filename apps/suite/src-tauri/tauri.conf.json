{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Arkly",
  "version": "0.41.10",
  "identifier": "de.pendzialek.archtools",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1480",
    "beforeBuildCommand": "npm run build:alle",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Arkly",
        "width": 1440,
        "height": 920,
        "minWidth": 1000,
        "minHeight": 640,
        "decorations": false,
        "shadow": true,
        "label": "main",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost data: blob: https://nominatim.openstreetmap.org https://api.open-meteo.com https://archive-api.open-meteo.com"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "category": "Productivity",
    "shortDescription": "Alle arch-tools in einem Fenster",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": [
          "German"
        ],
        "installerHooks": "windows/umbenennung.nsh"
      },
      "wix": {
        "language": "de-DE",
        "upgradeCode": "da193e78-daff-590b-b834-c36ea6866d2e"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQxRjZBRkRGNjZBMDUzNDcKUldSSFU2Qm0zNi8yUVhCNkM5YVFITG56a2xYMDNwdjFzOC9IVnRLWGtEZ0l3TURPS0JPaXMrenUK",
      "endpoints": [
        "https://github.com/axelcypher/arch-tools/releases/download/updater/suite.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}

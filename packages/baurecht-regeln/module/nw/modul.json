  "hinweise": [
    {
      "titel": "Bauvorlageberechtigung (§ 67 BauO NRW)",
      "text": "Bauvorlagen für die nicht verfahrensfreie Errichtung und Änderung von Gebäuden erstellt eine bauvorlageberechtigte Person (Architektin/Architekt, eingetragene Ingenieurin/eingetragener Ingenieur; für Gebäudeklassen 1 und 2 auch eingetragene Meister nach § 67 Abs. 4a)."
    },
    {
      "titel": "Formulare und digitale Einreichung",
      "text": "Der Bauantrag ist elektronisch einzureichen (§ 70 Abs. 1 BauO NRW); zu verwenden sind die Vordrucke nach § 1 Abs. 3 BauPrüfVO (Bekanntmachung im Ministerialblatt, Gliederungsnummer 23210)."
    },
    {
      "titel": "Kampfmittel: Auskunft vor Erdarbeiten",
      "text": "Vor Erdarbeiten über die örtliche Ordnungsbehörde eine Luftbildauswertung des Kampfmittelbeseitigungsdienstes beantragen. Die Kampfmittelverordnung regelt Funde und Räumung, nicht die Auskunft selbst.",
      "wenn": {
        "f": "vorhaben.erdarbeiten",
        "ist": true
      }
    },
    {
      "titel": "Gebäudeenergiegesetz geändert (Gesetz vom 23.07.2026)",
      "text": "Die GEG-UVO verweist noch auf die §§ 46 bis 51 und § 48 GEG alter Fassung; diese Paragrafen sind seit der Änderung durch das Gesetz vom 23.07.2026 weggefallen. Nachweise nach der geltenden Fassung des GEG führen und die Zuordnung mit der Bauaufsicht abstimmen."
    }
  ]
}

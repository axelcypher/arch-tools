    "3": {
      "gilt": {
        "$": "soest_aussen_bauen"
      },
      "grund": "In der Altstadt kann eine Unterschreitung der Abstandsflächen bis höchstens 0,125 H zugelassen werden (§ 89 Abs. 1 Nr. 6 BauO NRW); die Erforderlichkeit ist im Einzelfall aus dem historischen Stadtgrundriss abzuleiten und zu begründen.",
      "fundstellen": [
        "3/1",
        "3/2"
      ],
      "behoerde": {
        "$": "nw_prueft_kern"
      },
      "pruefen": {
        "grund": "Im Einzelfall prüfen – bei Anlagen, die keine Gebäude sind, aber wie Gebäude wirken (z. B. Mauern über 2 m): auch sie brauchen Abstandsflächen. Bei einer Nutzungsänderung gelten die gestalterischen Anforderungen nur, soweit das äußere Erscheinungsbild geändert wird.",
        "wenn": {
          "oder": [
            {
              "$": "nutzungsaenderung"
            },
            {
              "und": [
                {
                  "$": "bauen"
                },
                {
                  "m": "Gebäudeart",
                  "in": [
                    "kein Gebäude"
                  ]
                }
              ]
            }
          ]
        }
      },
      "hinweis": "Geht § 6 BauO NRW vor, soweit die Unterschreitung zugelassen wird – sie ist zu beantragen, nicht automatisch erlaubt.",
      "verweise": [
        "nw/bauo-nrw/6"
      ],
      "nachweis": [

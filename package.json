{
  "name": "arch-tools",
  "private": true,
  "type": "module",
  "description": "Werkzeuge für die Flächen- und Nutzungsberechnung: Flächenrechner (DIN 277, WoFlV), GRZ/GFZ-Nachweis, Kostenermittlung (DIN 276), Projektordner, Entzerrung von Fotos und Bauantragsformulare (SJ FORMA) – einzeln oder alle in einem Fenster (Rahmen-App)",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w flaechenrechner",
    "dev:grz": "npm run dev -w grz-nachweis",
    "dev:kosten": "npm run dev -w kostenermittlung",
    "dev:ordner": "npm run dev -w projektordner",
    "dev:entzerrung": "npm run dev -w entzerrung",
    "dev:formulare": "npm run dev -w formulare",
    "dev:suite": "npm run dev -w arch-tools-suite",
    "build": "npm run build -w flaechenrechner -w grz-nachweis -w kostenermittlung -w projektordner -w entzerrung -w formulare && npm run build -w arch-tools-suite",
    "test": "vitest run",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "tauri:dev": "npm run tauri:dev -w flaechenrechner",
    "tauri:dev:grz": "npm run tauri:dev -w grz-nachweis",
    "tauri:dev:kosten": "npm run tauri:dev -w kostenermittlung",
    "tauri:dev:ordner": "npm run tauri:dev -w projektordner",
    "tauri:dev:entzerrung": "npm run tauri:dev -w entzerrung",
    "tauri:dev:formulare": "npm run tauri:dev -w formulare",
    "tauri:dev:suite": "npm run tauri:dev -w arch-tools-suite"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.0",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "happy-dom": "^20.14.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
